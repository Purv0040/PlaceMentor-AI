# AI Resume Analyzer Environment Configuration

APP_NAME="AI Placement Copilot - Resume Analyzer"
APP_ENV="development"
DEBUG=True
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf"]
UPLOAD_DIR="./uploads"

# Data & NLP Settings
SKILLS_CSV_PATH="./data/skills.csv"
SPACY_MODEL="en_core_web_sm"

# ATS Scoring Weights (Must sum to 100)
WEIGHT_ESSENTIAL_SECTIONS=30
WEIGHT_TECHNICAL_SKILLS=30
WEIGHT_PROJECTS_EXPERIENCE=20
WEIGHT_CONTACT_INFO=10
WEIGHT_STRUCTURE=10
